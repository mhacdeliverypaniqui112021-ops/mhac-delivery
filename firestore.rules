rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // TESTING RULES ONLY.
    // All users authenticate anonymously. Production should add real Admin/Rider roles.
    match /mhac_orders/{orderId} {
      allow read, write: if request.auth != null;
    }
    match /mhac_config/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
